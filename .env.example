# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.5-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Override default Gemini model ───────────────────────────────────
# Default: gemini-2.5-flash (free-tier, fast)
# Alternatives: gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-flash-thinking-exp
# GEMINI_MODEL=gemini-2.5-flash

# ── Optional: Remote browser over CDP (anti-bot) ─────────────────────────────
# Point Playwright at an already-running Chrome via the Chrome DevTools Protocol
# instead of launching a throwaway headless instance. That browser keeps your
# real profile, cookies and residential IP, so anti-bot walls (Cloudflare, etc.)
# don't trigger — and if a captcha appears you solve it in your own browser.
#
# Start Chrome with remote debugging, then set CDP_URL:
#   google-chrome --remote-debugging-port=9222 # Accordingly to `CDP_URL` variable
#                 --user-data-dir=[] # Needed to have persistent browser state across restarts
#                 --enable-unsafe-extension-debugging # Depending on your setup

#
# Applies to: check-liveness.mjs, generate-pdf.mjs, scan.mjs --verify,
#             scan-ats-full.mjs --liveness.
# CDP_URL=http://localhost:9222

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration
